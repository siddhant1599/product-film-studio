<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${title}</title>
  <link rel="preload" href="assets/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="film.css">
</head>
<body>
  <main id="root" data-composition-id="main" data-width="${width}" data-height="${height}" data-fps="${fps}" data-duration="${duration}" data-frames="${frames}" data-reveal-frame="${reveal_frame}" style="width:${width}px;height:${height}px">
    <canvas id="plates" width="${width}" height="${height}" data-layout-allow-overlap></canvas>
    <header id="caption">
      <h1>${title}</h1>
      <p id="subtitle">${subtitle}</p>
      <span id="accent" aria-hidden="true"></span>
    </header>
    <audio id="effects" class="clip" src="assets/effects.wav" data-start="0" data-duration="${duration}" data-track-index="2" data-volume="1"></audio>
  </main>
  <script src="assets/gsap.min.js"></script>
  <script src="film.js"></script>
</body>
</html>
